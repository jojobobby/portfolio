---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('writing')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Blog & Chat" description="Blog posts by Rapheal Robinson. Comment on any post, no account needed.">
  <h1>Blog &amp; Chat</h1>
  <ul class="posts">
    {posts.map((post) => (
      <li>
        <a href={`/writing/${post.id}`}>
          <span class="kind">{post.data.kind}{post.data.tag ? ` ${post.data.tag}` : ''} <span class="post-date">{post.data.date.toISOString().slice(0, 10)}</span></span>
          <span class="title">{post.data.title}</span>
          <span class="dim">{post.data.summary}</span>
        </a>
      </li>
    ))}
  </ul>
</Base>
