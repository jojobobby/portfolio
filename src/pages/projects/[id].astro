---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import YouTube from '../../components/YouTube.astro';
import { videoDate } from '../../data/videos';

export async function getStaticPaths() {
  const rank = { professional: 0, studio: 1, earlier: 2 };
  const projects = (await getCollection('projects')).sort(
    (a, b) => rank[a.data.section] - rank[b.data.section] || a.data.order - b.data.order,
  );
  return projects.map((project, i) => ({
    params: { id: project.id },
    props: { project, prev: projects[i - 1], next: projects[i + 1] },
  }));
}

const { project, prev, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const related = (await getCollection('writing')).filter((w) => w.data.project === project.id);
const showShot = !d.video && d.cover && /\.(jpe?g|png|webp)$/i.test(d.cover);
---
<Base title={d.title} description={d.summary}>
  <p><a href="/">← All projects</a></p>
  <header class="project-head">
    <span class="tile__role">{d.role}, {d.dates}</span>
    <h1>{d.title}</h1>
    <p class="lede">{d.summary}</p>
    {d.tech.length > 0 && <div class="facts">{d.tech.map((t) => <span class="chip">{t}</span>)}</div>}
  </header>

  {d.video && <YouTube id={d.video} title={`${d.title} gameplay`} date={videoDate(d.video)} />}
  {showShot && <figure class="hero-media"><img src={d.cover} alt={d.coverAlt ?? ''} /></figure>}

  {d.stats.length > 0 && (
    <div class="stats">
      {d.stats.map((s) => (
        <div class="stat"><div class="stat__value">{s.value}</div><div class="stat__label">{s.label}</div></div>
      ))}
    </div>
  )}

  <article class="prose"><Content /></article>

  {related.length > 0 && (
    <section class="prose">
      <h2>Writing</h2>
      <ul>{related.map((post) => <li><a href={`/writing/${post.id}`}>{post.data.title}</a></li>)}</ul>
    </section>
  )}

  <nav class="pager" aria-label="More projects">
    {prev && <a href={`/projects/${prev.id}`}><span class="dir">← Previous</span><div><strong>{prev.data.title}</strong></div></a>}
    {next && <a class="next" href={`/projects/${next.id}`}><span class="dir">Next →</span><div><strong>{next.data.title}</strong></div></a>}
  </nav>
</Base>
