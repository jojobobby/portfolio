---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const related = (await getCollection('writing')).filter((w) => w.data.project === project.id);
const showHero = d.cover && !d.cover.endsWith('.gif');
---
<Base title={d.title} description={d.summary}>
  <p><a href="/">← All projects</a></p>
  <header class="project-head">
    <span class="tile__role">{d.role}</span>
    <h1>{d.title}</h1>
    <span class="dim">{d.org} · {d.dates}</span>
    {d.tech.length > 0 && (
      <div class="facts">{d.tech.map((t) => <span class="chip">{t}</span>)}</div>
    )}
  </header>

  {showHero && (
    <figure class="hero-media">
      <img src={d.cover} alt={d.coverAlt ?? ''} />
    </figure>
  )}

  {d.stats.length > 0 && (
    <div class="stats">
      {d.stats.map((s) => (
        <div class="stat">
          <div class="stat__value">{s.value}</div>
          <div class="stat__label">{s.label}</div>
        </div>
      ))}
    </div>
  )}

  <article class="prose">
    <Content />
  </article>

  {related.length > 0 && (
    <section>
      <h2>Related writing</h2>
      <ul class="posts">
        {related.map((post) => (
          <li>
            <a href={`/writing/${post.id}`}>
              <span class="kind">{post.data.kind}</span>
              <span class="title">{post.data.title}</span>
              <span class="dim">{post.data.summary}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
