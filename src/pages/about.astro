---
import Base from '../layouts/Base.astro';
import { SITE } from '../site';

// Kept in sync with the résumé PDFs by hand. Public page: no phone number or street address.
const jobs = [
  {
    title: 'Site Reliability Engineer Apprentice',
    org: 'Vail Systems',
    when: 'Aug 2024 to Present',
    link: '/projects/vail-sre',
    points: [
      'Led the migration of production workloads from AWS ECS/ECR to self-managed Kubernetes (k3s), with Helm and Argo CD GitOps across development, staging and production.',
      'Rebuilt GitHub Actions delivery for Node.js/Next.js and .NET services: versioned images, database migrations and health checks during releases.',
      'Deployed and operate Terraform, Ansible, Vault, cert-manager, Harbor, and a Prometheus/Grafana/Loki stack for rollout validation and failure analysis.',
      'Hardened cluster access with RBAC, namespaced service accounts, network policies, certificate-based SSH, 2FA and host firewalls.',
      'Containerized C++ services (Make, Conan, GCC) and shipped them through reusable Helm chart templates.',
      'Mentor Seneca Foundation interns on a k3s training cluster I built and administer.',
    ],
  },
  {
    title: 'Software Engineer Intern',
    org: 'Vail Systems',
    when: 'Mar 2023 to Aug 2024',
    link: '/projects/vail-software',
    points: [
      'Delivered full-stack features weekly in React, TypeScript, Node.js, Express, Prisma and SQL.',
      'Traced defects across UI, API, database and deployment layers; improved release workflows.',
    ],
  },
  {
    title: 'Founder',
    org: 'Tidan Games LLC',
    when: 'Sep 2026 to Present',
    link: '/projects/arcana',
    points: [
      'Run an independent multiplayer game studio, leading engineers, artists and testers across game servers, clients, APIs, databases and infrastructure.',
      'Lead engineer and designer of Arcana (formerly Tidan’s Realm VI, 818 player accounts); operate the studio platform (35 Argo CD applications on k3s).',
      'Write the C#/.NET 10 game server, ASP.NET Core Razor Pages website and tools, and WPF/XAML launcher; cut a 26 s server stall to about 1 s by replacing a List with a HashSet and time-slicing the work.',
    ],
  },
  {
    title: 'Lead Software Engineer & Owner',
    org: 'Cosmic Realm (originally Tidan’s Realm)',
    when: 'Aug 2018 to 2026',
    link: '/projects/cosmic-realm',
    points: [
      'Built and operated a C# multiplayer game server: 3,000 registered accounts, 200 peak concurrent players.',
      'C#/.NET MMORPG server with multithreaded game instances, hybrid UDP/TCP networking, a player-driven market and an auto-updating WPF launcher.',
      'Upgraded the server from .NET Framework 4.6 to .NET 10; built an ASP.NET Core account server and a Razor Pages shop with Stripe.',
      'Ran production on k3s with Kustomize and Argo CD, Redis backups three times daily, and Prometheus/Grafana/Loki.',
    ],
  },
  {
    title: 'Software Engineer Apprentice',
    org: 'Seneca Foundation',
    when: 'Jul 2022 to Apr 2023',
    link: '/projects/seneca',
    points: ['Built full-stack applications with Java, TypeScript and MySQL under senior-engineer mentorship.'],
  },
];

const skills = [
  ['Reliability & platform', 'Kubernetes (k3s), Helm, Kustomize, Argo CD, GitOps, Prometheus, Grafana, Loki, cert-manager, ingress, RBAC, network policies, secrets management'],
  ['Cloud & automation', 'AWS (ECS, ECR, EC2, IAM, Secrets Manager, Route 53, ACM), Terraform, Ansible, Linux, systemd, SSH'],
  ['Delivery', 'GitHub Actions, Docker, Podman, Harbor, BuildKit, release engineering'],
  ['Languages', 'C# (since 2018), C++, TypeScript, JavaScript, Python, Java, Haxe, Bash, SQL'],
  ['.NET', '.NET Framework 4.6 to .NET 10, ASP.NET Core, Razor Pages, Blazor, WPF/XAML, MonoGame, prometheus-net, NUnit, xUnit'],
  ['Software', 'React, Next.js, Node.js, Express, Prisma, REST APIs, Haxe/OpenFL'],
  ['Data', 'PostgreSQL, Redis, MySQL, migrations, connection pooling'],
  ['Game systems', 'Multiplayer networking (TCP/UDP, WebSockets, binary protocols), multithreading, combat, progression, economies, dungeon and systems design'],
];
---
<Base title="About & Résumé" description="About Rapheal Robinson, site reliability engineer and game developer, with his résumé.">
  <h1>About</h1>
  <div class="prose">
    <p>
      SRE at Vail Systems and founder of Tidan Games. I've been making multiplayer games since 2018,
      and running them is what got me into infrastructure.
    </p>
    <p class="dim">Based near Chicago and open to relocation. I speak English and Spanish, and I'm studying for the CKA.</p>
  </div>
  <div class="actions">
    <a class="btn" href={`mailto:${SITE.email}`}>Email me</a>
    <a class="btn btn--ghost" href={SITE.linkedin} rel="me">LinkedIn</a>
    <a class="btn btn--ghost" href={SITE.github} rel="me">GitHub</a>
    <a class="btn btn--ghost" href={SITE.youtube} rel="me">YouTube</a>
  </div>

  <h2 class="section-title">Résumé</h2>
  <hr class="section-rule" />
  <div class="prose">
    <h2>Experience</h2>
    {jobs.map((j) => (
      <div class="resume-job">
        <h3><a href={j.link}>{j.title}</a>, {j.org}</h3>
        <div class="when">{j.when}</div>
        <ul>{j.points.map((p) => <li>{p}</li>)}</ul>
      </div>
    ))}

    <h2>Skills</h2>
    <table>
      <tbody>
        {skills.map(([k, v]) => (
          <tr><th scope="row">{k}</th><td>{v}</td></tr>
        ))}
      </tbody>
    </table>

    <h2>Education & certification</h2>
    <ul>
      <li><strong>Associate in Arts, Computer Science</strong>, Prairie State College, Chicago Heights, IL (Jul 2025)</li>
      <li><strong>Google IT Support Certificate</strong> (May 2026), <a href="https://credly.com/go/aJ6UHHbO">verify on Credly</a></li>
      <li><strong>Certified Kubernetes Administrator (CKA)</strong>, in progress</li>
    </ul>
  </div>
</Base>
