---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectTile from '../components/ProjectTile.astro';
import YouTube from '../components/YouTube.astro';
import { SITE } from '../site';

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const professional = all.filter((p) => p.data.section === 'professional');
const studio = all.filter((p) => p.data.section === 'studio');
const earlier = all.filter((p) => p.data.section === 'earlier');
const posts = (await getCollection('writing')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const numbers = [
  { value: '8 yrs', label: 'making multiplayer games' },
  { value: '818', label: 'Arcana players' },
  { value: '35', label: 'apps on my cluster' },
  { value: 'ECS → k3s', label: 'migration I led at Vail' },
];

// From my channel. Titles are the videos' own.
const videos = [
  { id: 'cRzuc4sMsc4', title: 'Quest Showcase' },
  { id: 'FiEjzFGnL5Y', title: 'Summoner Showcase' },
  { id: 'o_K_tfyDBZI', title: 'Item Leveling Showcase' },
  { id: 'MMVDr1D3cBE', title: 'Crafting Station Showcase' },
  { id: 'j-M6-yfaEho', title: 'Crypt Centipede Boss Fight' },
  { id: '23oV2G1G6sU', title: 'Boss Behavior' },
];
---
<Base>
  <section class="hero">
    <div class="hero__text">
      <h1 class="hero__title">I make multiplayer games <span class="accent">and run the servers they live on.</span></h1>
      <p class="lede">SRE at Vail Systems. Founder of Tidan Games, where I build Arcana.</p>
      <div class="actions">
        <a class="btn" href="#studio">Projects</a>
        <a class="btn btn--ghost" href={SITE.youtube}>YouTube</a>
        <a class="btn btn--ghost" href="/about">Résumé</a>
      </div>
    </div>
    <div class="hero__video">
      <YouTube id="hUZl8HxzW1o" title="Arcana public testing gameplay" />
    </div>
  </section>

  <section class="numbers" aria-label="At a glance">
    {numbers.map((n) => (
      <div class="number"><div class="number__value">{n.value}</div><div class="number__label">{n.label}</div></div>
    ))}
  </section>

  <h2 class="section-title" id="studio">Studio Projects</h2>
  <hr class="section-rule" />
  <div class="tiles">{studio.map((p) => <ProjectTile project={p} />)}</div>

  <h2 class="section-title" id="videos">Videos</h2>
  <hr class="section-rule" />
  <div class="vids">
    {videos.map((v) => (
      <a class="vid" href={`https://www.youtube.com/watch?v=${v.id}`}>
        <span class="vid__thumb">
          <img src={`https://i.ytimg.com/vi/${v.id}/maxresdefault.jpg`} onerror="this.onerror=null;this.src=this.src.replace('maxresdefault','hqdefault')" alt="" loading="lazy" decoding="async" />
          <span class="play" aria-hidden="true">▶</span>
        </span>
        <span class="vid__title">{v.title}</span>
      </a>
    ))}
  </div>
  <p class="section-note"><a href={SITE.youtube}>More on my YouTube →</a></p>

  <h2 class="section-title" id="professional">Professional</h2>
  <hr class="section-rule" />
  <div class="tiles">{professional.map((p) => <ProjectTile project={p} />)}</div>

  <h2 class="section-title">Earlier</h2>
  <hr class="section-rule" />
  <div class="earlier">
    {earlier.map((p) => (
      <a href={`/projects/${p.id}`}><strong>{p.data.title}</strong><div class="meta">{p.data.summary}</div></a>
    ))}
  </div>

  <h2 class="section-title">Writing</h2>
  <hr class="section-rule" />
  <ul class="posts">
    {posts.map((post) => (
      <li><a href={`/writing/${post.id}`}><span class="kind">{post.data.kind}</span><span class="title">{post.data.title}</span></a></li>
    ))}
  </ul>

  <p class="contact">
    <a href={`mailto:${SITE.email}`}>{SITE.email}</a> · <a href={SITE.linkedin}>LinkedIn</a> ·
    <a href={SITE.github}>GitHub</a> · <a href={SITE.youtube}>YouTube</a>
  </p>
</Base>
