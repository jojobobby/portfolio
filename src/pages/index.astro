---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectTile from '../components/ProjectTile.astro';
import YouTube from '../components/YouTube.astro';
import { SITE } from '../site';
import { videos, stamp, videoDate } from '../data/videos';

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const professional = all.filter((p) => p.data.section === 'professional');
const studio = all.filter((p) => p.data.section === 'studio');
const earlier = all.filter((p) => p.data.section === 'earlier');
const posts = (await getCollection('writing')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// The headline facts, each linked to the page or post that backs it up.
const highlights = [
  {
    area: 'Game design and development',
    items: [
      { value: '10,000+', label: 'accounts created on my games', href: '/#studio' },
      { value: '8 years', label: 'designing and running live multiplayer games, 2018 to 2026', href: '/projects/cosmic-realm' },
      { value: 'CI-UT', label: 'every update played by 50+ testers before it ships', href: '/writing/playtest-constantly' },
      { value: '5', label: 'design lessons from shipping games, written up', href: '/writing' },
    ],
  },
  {
    area: 'Site reliability',
    items: [
      { value: '5', label: 'deployment architectures built, run and replaced', href: '/writing/seneca-infrastructure-journey' },
      { value: '2', label: 'production Kubernetes clusters I run with GitOps', href: '/projects/kubernetes-platform' },
      { value: '4', label: 'postmortems written, 2 of them public so far', href: '/writing' },
      { value: '$12.6k', label: 'projected 10 year saving on one node, from my hosting analysis', href: '/writing/aws-vs-ovh-k3s-cost-analysis' },
    ],
  },
  {
    area: 'Software engineering',
    items: [
      { value: '4,600+', label: 'commits across 64 repos since 2018', href: '/projects/csharp-dotnet' },
      { value: '1,879', label: 'of them written 2018 to 2024, before I used AI tools', href: '/projects/csharp-dotnet' },
      { value: '4.6 to 10', label: '.NET versions my servers have run on', href: '/projects/csharp-dotnet' },
      { value: '26 s to 1 s', label: 'server freeze fixed by swapping a List for a HashSet', href: '/writing/list-that-froze-the-server' },
    ],
  },
];

// Videos: src/data/videos.json (oldest first). Thumbnails are local copies: scripts/fetch-thumbnails.mjs.
---
<Base>
  <section class="hero">
    <div class="hero__text">
      <h1 class="hero__title">I make multiplayer games <span class="accent">and run the servers they live on.</span></h1>
      <p class="lede">SRE at Vail Systems. Founder of Tidan Games, where I build Arcana.</p>
      <div class="actions">
        <a class="btn" href="#studio">Projects</a>
        <a class="btn btn--ghost" href={SITE.youtube}>YouTube</a>
        <a class="btn btn--ghost" href="/about">Résumé</a>
      </div>
    </div>
    <div class="hero__video">
      <YouTube id="hUZl8HxzW1o" title="Arcana public testing gameplay" date={videoDate('hUZl8HxzW1o')} />
    </div>
  </section>

  <section class="highlights" aria-label="Highlights">
    {highlights.map((g) => (
      <div class="highlights__group">
        <h2 class="highlights__area">{g.area}</h2>
        <div class="numbers">
          {g.items.map((n) => (
            <a class="number" href={n.href}><div class="number__value">{n.value}</div><div class="number__label">{n.label}</div></a>
          ))}
        </div>
      </div>
    ))}
  </section>

  <h2 class="section-title" id="studio">Studio Projects</h2>
  <hr class="section-rule" />
  <div class="tiles">{studio.map((p) => <ProjectTile project={p} />)}</div>

  <h2 class="section-title" id="professional">Professional</h2>
  <hr class="section-rule" />
  <div class="tiles">{professional.map((p) => <ProjectTile project={p} />)}</div>

  <h2 class="section-title">Earlier</h2>
  <hr class="section-rule" />
  <div class="earlier">
    {earlier.map((p) => (
      <a href={`/projects/${p.id}`}><strong>{p.data.title}</strong><div class="meta">{p.data.summary}</div></a>
    ))}
  </div>

  <div class="section-head">
    <h2 class="section-title">Blog &amp; Chat</h2>
    <a class="section-more" href="/writing">Show more</a>
  </div>
  <hr class="section-rule" />
  <ul class="posts">
    {posts.map((post) => (
      <li><a href={`/writing/${post.id}`}><span class="kind">{post.data.kind}{post.data.tag ? ` ${post.data.tag}` : ''}</span><span class="title">{post.data.title}</span></a></li>
    ))}
  </ul>

  <div class="section-head">
    <h2 class="section-title" id="videos">Videos</h2>
    <a class="section-more" href="/videos">Show more</a>
  </div>
  <hr class="section-rule" />
  <div class="vids">
    {videos.map((v) => (
      <a class="vid" href={`https://www.youtube.com/watch?v=${v.id}`}>
        <span class="vid__thumb">
          <img src={`/media/yt/${v.id}.jpg`} alt="" loading="lazy" decoding="async" />
          <span class="play" aria-hidden="true">▶</span>
        </span>
        <span class="vid__title">{v.title}</span>
        <span class="vid__date">{stamp(v.date)}</span>
      </a>
    ))}
  </div>

  <p class="contact">
    <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    <a href={SITE.linkedin}>LinkedIn</a>
    <a href={SITE.github}>GitHub</a>
    <a href={SITE.youtube}>YouTube</a>
  </p>
</Base>
